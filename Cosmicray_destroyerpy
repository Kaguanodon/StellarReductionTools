import numpy as np
from scipy.interpolate import CubicSpline

data = np.loadtxt("/home/kaguanodon/90089A/CCD3/Sky/90089A_3_trim.xy.norm")
wave = data[:,0]
flux = data[:,1]

bad_min = 7175.9235
bad_max = 7176.0970

bad = (wave >= bad_min) & (wave <= bad_max)

left = np.where(wave < bad_min)[0][-5:]
right = np.where(wave > bad_max)[0][:5]

good = np.concatenate((left, right))

spline = CubicSpline(wave[good], flux[good])

replacement = spline(wave[bad])

print("Replacement values:")
for w, f in zip(wave[bad], replacement):
    print(f"{w:.11f}  {f:.5f}")

flux[bad] = replacement